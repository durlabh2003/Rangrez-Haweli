# ==============================================================================
# RANGREZ HAVELI — ENVIRONMENT CONFIGURATION TEMPLATE
# Never commit actual secrets or credentials. Copy to .env for local usage.
# ==============================================================================

# Environment mode ('development' | 'production')
ENV=development
NODE_ENV=development
PORT=3000
APP_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000"

# Gemini AI Grounded Heritage Search (Verified Active Model Supporting googleSearch)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-4-hydrogen"

# Admin Role Allowlist (Comma-separated verified Google emails)
ADMIN_EMAILS="durlabhdaryani70@gmail.com"

# Firebase Admin SDK & App Check (Optional in local dev, required for prod Firestore Admin writes)
GOOGLE_APPLICATION_CREDENTIALS=""
VITE_FIREBASE_APP_CHECK_KEY=""
FIREBASE_APP_CHECK_ENFORCE="false"

# Legal & Statutory Business Placeholders (TODO: Replace before launch & verify with counsel)
LEGAL_ENTITY_NAME="LEGAL_ENTITY_NAME [TODO: Registered Company Name]"
LEGAL_ADDRESS="LEGAL_ADDRESS [TODO: Complete Registered Jaipur Address]"
LEGAL_GSTIN="LEGAL_GSTIN [TODO: 15-Digit GSTIN]"
GRIEVANCE_OFFICER_NAME="GRIEVANCE_OFFICER_NAME [TODO: Designated Officer Name]"
GRIEVANCE_OFFICER_EMAIL="grievance@example.invalid"
GRIEVANCE_RESPONSE_TIMELINE="Within 48 business hours (acknowledgement), resolved within 30 days"
LEGAL_JURISDICTION="Jaipur, Rajasthan, India"

# Payment Service Provider (Razorpay / Configurable PSP Adapter)
PSP_PROVIDER="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PREPAID_INCENTIVE_INR="50"

# Courier Serviceability, SMS (DLT), Email & FX External Adapters
COURIER_API_URL=""
COURIER_API_KEY=""
SMS_PROVIDER_URL=""
SMS_API_KEY=""
SMS_DLT_TEMPLATE_ID="DLT_TEMPLATE_ID [TODO: Register TRAI DLT OTP Template]"
EMAIL_PROVIDER_URL=""
EMAIL_API_KEY=""
FX_API_URL=""
